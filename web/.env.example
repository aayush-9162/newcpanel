# Vite env — copy to `.env` (or `.env.local`) before running `npm run dev`.
# Vars must start with VITE_ to be exposed to the React bundle.
#
# NOTE: these are baked in at BUILD time. After changing this file you must
# rebuild (npm run build) for a served build, or restart `npm run dev`.

# Google Sign-In — the OAuth 2.0 Web client id (from Google Cloud Console).
# Must match GOOGLE_CLIENT_ID in server/.env. The app's URL must be listed
# under the client's "Authorized JavaScript origins" or the button won't work.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional — shown in the sidebar footer as "Connected to <X>".
# Leave empty to hide the line. Purely cosmetic.
VITE_DATA_HOST=
