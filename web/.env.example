# Vite env — copy to `.env` (or `.env.local`) before running `npm run dev`.
# Vars must start with VITE_ to be exposed to the React bundle.

# Where Keycloak lives (the SSO docker-compose stack).
# Use the LAN IP (not localhost) if you want other devices on the network to
# be able to sign in too — the URL has to be resolvable from each user's browser.
VITE_KEYCLOAK_URL=http://192.168.68.11:8080

# Realm + client created by sso/realm-export/cfc-realm.json
VITE_KEYCLOAK_REALM=cfc
VITE_KEYCLOAK_CLIENT=cpanel-web

# Optional — shown in the sidebar footer as "Connected to <X>".
# Leave empty to hide the line. Purely cosmetic.
VITE_DATA_HOST=
